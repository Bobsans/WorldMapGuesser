{
  "name": "world-map-guesser-game",
  "version": "2.0.0",
  "description": "Find countries on an interactive world map.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "stylelint": "stylelint \"src/**/*.{vue,scss}\" --max-warnings 0",
    "format": "npm run lint:fix && npm run stylelint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run stylelint && npm run test && npm run build",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "stylelint:fix": "stylelint \"src/**/*.{vue,scss}\" --fix --max-warnings 0"
  },
  "author": "Bobsans",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@fontsource/comfortaa": "5.3.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/stylelint-plugin": "5.3.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "postcss": "8.5.31",
    "postcss-html": "2.0.0",
    "postcss-scss": "4.0.9",
    "sass": "1.106.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
