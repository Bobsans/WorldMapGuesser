{
    "presets": [
        ["@babel/preset-env", {
            "targets": {
                "browsers": [
                    "> 2%",
                    "not ie <= 10",
                    "not op_mini all",
                    "not dead"
                ]
            },
            "loose": true,
            "useBuiltIns": "usage",
            "modules": false,
            "forceAllTransforms": false
        }]
    ],
    "plugins": [
        ["@babel/plugin-transform-runtime", {
            "helpers": false,
            "regenerator": false,
            "useESModules": true
        }],
        "@babel/plugin-syntax-dynamic-import",
        "@babel/plugin-proposal-class-properties"
    ],
    "comments": false
}
